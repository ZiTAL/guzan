# This file is loaded by docker-compose via `env_file: .env`.
# Copy this file to .env (in private/docker/) and fill in your values.
# .env is gitignored, so secrets here are never committed.
# A Gmail "App Password" is required for GUZAN_SMTP_PASS.
# Values left empty disable email notifications (submissions still work).

GUZAN_PUBLIC_URL=https://guzan.eus

GUZAN_SMTP_HOST=smtp.gmail.com
GUZAN_SMTP_PORT=465
GUZAN_SMTP_SECURE=true

GUZAN_SMTP_USER=your.address@gmail.com
GUZAN_SMTP_PASS=your-16-char-app-password

# The account that receives the review notifications.
GUZAN_MAIL_TO=your.address@gmail.com
GUZAN_MAIL_ENABLED=true
